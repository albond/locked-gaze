{
  "manifest_version": 3,
  "name": "Locked Gaze Camera",
  "version": "1.2.0",
  "description": "Only for Macs that block the Locked Gaze camera: adds it to web meetings. Otherwise leave it off.",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.webex.com/*",
        "https://meet.jit.si/*",
        "https://8x8.vc/*",
        "https://whereby.com/*",
        "https://app.slack.com/*",
        "https://discord.com/*",
        "https://preply.com/*",
        "https://*.preply.com/*"
      ],
      "js": [
        "inject-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.webex.com/*",
        "https://meet.jit.si/*",
        "https://8x8.vc/*",
        "https://whereby.com/*",
        "https://app.slack.com/*",
        "https://discord.com/*",
        "https://preply.com/*",
        "https://*.preply.com/*"
      ],
      "js": [
        "inject-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Click to use Locked Gaze Camera on this site",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
